# Web app: public deployment addresses only. Copy to apps/web/.env.local.
PUBLIC_CONVEX_URL=
PUBLIC_CONVEX_SITE_URL=
CONVEX_DEPLOYMENT=
# Configure the following in Convex via private prompts/convex env, NOT in public env:
# BETTER_AUTH_SECRET (generated during backend provisioning)
# SITE_URL=http://localhost:5173
# RESEND_API_KEY
# AUTH_EMAIL_FROM=Living Carousel <signin@auth.yourdomain.com>
# RESEND_WEBHOOK_SECRET (optional for delivery/bounce status)
# R2_ACCESS_KEY_ID
# R2_SECRET_ACCESS_KEY
# R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# R2_BUCKET
# Future paid-generation secrets: PAYPAL_CLIENT_ID, PAYPAL_CLIENT_SECRET,
# PAYPAL_WEBHOOK_ID, FAL_KEY, RENDER_API_KEY.
