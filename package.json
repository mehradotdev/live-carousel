{
  "name": "living-carousel",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp -C apps/web dev",
    "build": "vp -C apps/web build",
    "check": "vp check && pnpm --filter @living/web check && eslint apps/web/src && prettier --check \"apps/**/*.svelte\"",
    "format": "vp fmt && prettier --write \"apps/**/*.svelte\"",
    "test": "vp test run",
    "test:e2e": "playwright test",
    "prepare": "vp config --no-agent",
    "lint:commits": "commitlint",
    "backend": "pnpm --filter @living/web convex:dev"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@playwright/test": "1.64.1",
    "eslint": "9.39.5",
    "eslint-plugin-svelte": "3.23.1",
    "fflate": "0.8.3",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@12.16.1"
}
